APP_NAME="P4DC Cyber Range"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ctf.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=padcadmin

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=p4dc
DB_USERNAME=p4dc
DB_PASSWORD=your-secure-production-password-here
DB_SSLMODE=prefer

BCRYPT_ROUNDS=12
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

APP_FORWARD_PORT=8080
DB_FORWARD_PORT=5433

# Optional challenge oracle host and port overrides
# ORACLE_HOST=ctf.example.com
# ORACLE_PORT=5000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
